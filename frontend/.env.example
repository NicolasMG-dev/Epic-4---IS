NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_URL_LOCAL=http://localhost:8080/api
NEXT_PUBLIC_API_URL_DEV=
NEXT_PUBLIC_API_URL_PROD=
FRONTEND_PORT=3000

# Modo "solo Epic 4" (Publicar vacante sin login). Dejar vacío en el desarrollo normal.
NEXT_PUBLIC_STANDALONE_EPIC4=
# Empresa con la que se publica mientras no exista el login de empresa (Epic 1).
# Ids de ejemplo del seed: a0000000-0000-4000-8000-000000000001 (TechBolivia S.R.L.),
# ...0002 (NovaSoft Bolivia), ...0003 (Andes Data Labs)
NEXT_PUBLIC_DEMO_COMPANY_ID=
NEXT_PUBLIC_DEMO_COMPANY_NAME=
