-export function formatSalaryRange(salaryMin: number, salaryMax?: number): string {
+export function formatSalaryRange(salaryMin?: number, salaryMax?: number): string {
+  if (salaryMin === undefined) return JOB_OFFER_SALARY_TO_BE_AGREED;
